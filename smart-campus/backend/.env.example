# Smart Campus Backend Environment Variables

# Application
APP_NAME="Smart Campus Navigator"
APP_VERSION="1.0.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./smart_campus.db

# Campus Data
CAMPUS_DATA_DIR=../campus-data
DEFAULT_CAMPUS_ID=cu-gharaun

# AI Provider
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash

# Admin
ADMIN_SECRET=changeme-in-production

# Uploads
UPLOAD_DIR=../uploads

# Smart Meetup Point Weights & Radius
MEETUP_WEIGHT_EQUIDISTANCE=0.4
MEETUP_WEIGHT_ACCESSIBILITY=0.2
MEETUP_WEIGHT_POPULARITY=0.2
MEETUP_WEIGHT_LANDMARK=0.2
MEETUP_DEFAULT_RADIUS_METERS=400
